    <build>
        <plugins>
            <!-- JSBML ships its JUnit test classes inside its jars, some of them (e.g.
                AssignmentRuleDerivedUnitsTest) mixed into the very same package as the
                production classes cy3sbml needs (org.sbml.jsbml, org.sbml.jsbml.util, ...).
                maven-bundle-plugin's Export-Package can only exclude by whole package, so it
                cannot reach those; unpack the jsbml/jsbml-* jars here, with the test classes
                and test/testdata packages filtered out, into a directory the bundle plugin
                below copies in via Include-Resource instead of classpath-borrowing them
                straight from the (unfiltered) jars.
                Restricted to the jsbml-prefixed artifacts on purpose: jtidy (the other
                cy3sbml-dep artifact, the third-party HTML tidy library JSBML's own
                jsbml-tidy module wraps) ships no test classes to filter, and unpacking it
                here too would additionally spill its own resources (e.g. tidy.gif) at the
                bundle root; it stays a normal embedded (nested-jar) dependency instead, via
                the explicit Embed-Dependency clause for it below. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.7.0</version>
                <executions>
                    <execution>
                        <id>unpack-jsbml-without-tests</id>
                        <goals>
                            <goal>unpack-dependencies</goal>
                        </goals>
                        <phase>process-classes</phase>
                        <configuration>
                            <includeGroupIds>cy3sbml-dep</includeGroupIds>
                            <includeArtifactIds>jsbml,jsbml-qual,jsbml-layout,jsbml-comp,jsbml-fbc,jsbml-groups,jsbml-distrib,jsbml-tidy</includeArtifactIds>
                            <outputDirectory>${project.build.directory}/jsbml-classes</outputDirectory>
                            <excludes>META-INF/**,
                                **/test/**,
                                **/testdata/**,
                                **/*Test.class,
                                **/*Test$*.class,
                                **/*Tests.class,
                                **/*Tests$*.class,
                                **/*JUnitTests.class</excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- bundle -->
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <version>${maven-bundle-plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <!-- The BND instructions for the bundle -->
                    <instructions>
                        <Bundle-SymbolicName>${bundle.symbolicName}</Bundle-SymbolicName>
                        <Bundle-Version>${project.version}</Bundle-Version>
                        <Export-Package>${bundle.namespace}.*;version="${project.version}"</Export-Package>
                        <!-- org.sbml.jsbml.* is exported from whatever the unpack-jsbml-without-tests
                            execution above put in target/jsbml-classes (see Include-Resource below),
                            rather than by classpath-borrowing it from the jsbml jars directly: that
                            would also pull in their (test-class-contaminated) packages. -->
                        <_exportcontents>org.sbml.jsbml.*</_exportcontents>
                        <Private-Package>${bundle.namespace}.*</Private-Package>
                        <Bundle-Activator>${bundle.namespace}.CyActivator</Bundle-Activator>
                        <!-- jtidy is excluded from the generic clause (its groupId is
                            cy3sbml-dep) since it is not part of the filtered jsbml-classes
                            unpack above; the explicit second clause embeds it normally
                            (as a nested jar), same as before that unpack existed. -->
                        <Embed-Dependency>*;scope=!provided|test;groupId=!org.cytoscape;groupId=!cy3sbml-dep,
                            jtidy;groupId=cy3sbml-dep;scope=!provided|test</Embed-Dependency>
                        <Embed-Transitive>true</Embed-Transitive>
                        <!-- {maven-resources} is bnd's default resource copy (src/main/resources,
                            e.g. the gui templates, styles and the bundled extension jar); an
                            explicit Include-Resource instruction replaces that default, so it must
                            be listed here explicitly alongside the filtered jsbml classes. -->
                        <Include-Resource>{maven-resources}, ${project.build.directory}/jsbml-classes</Include-Resource>
                        <DynamicImport-Package>netscape.javascript</DynamicImport-Package>
                        <!--
                        <Import-Package>*;resolution:=optional</Import-Package>
                        -->
                        <Import-Package>javax.xml.namespace, *;resolution:=optional</Import-Package>
                    </instructions>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <inherited>true</inherited>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <showWarnings>true</showWarnings>
                    <showDeprecation>true</showDeprecation>
                    <compilerArgs>
                        <arg>-Xmaxwarns</arg>
                        <arg>10000</arg>
                        <arg>-Xmaxerrs</arg>
                        <arg>10000</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- resources -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.5.0</version>
            </plugin>
            <!-- jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>3.2.0</version>
            </plugin>
            <!-- pinned: the bundle packaging does not bind a version, so Maven
                resolves the newest one and warns about the Maven 4 betas -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>3.2.0</version>
            </plugin>

            <!-- testing -->
            <plugin>
