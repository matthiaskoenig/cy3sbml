            <artifactId>jsbml-distrib</artifactId>
            <version>${jsbml.version}</version>
        </dependency>
        <dependency>
            <groupId>cy3sbml-dep</groupId>
            <artifactId>jsbml-tidy</artifactId>
            <version>${jsbml.version}</version>
        </dependency>
        <dependency>
            <groupId>cy3sbml-dep</groupId>
            <artifactId>jtidy</artifactId>
            <version>r938</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.woodstox</groupId>
            <artifactId>woodstox-core</artifactId>
            <version>7.2.2</version>
        </dependency>
        <!-- Used by org.sbml.jsbml.xml.parsers.SBMLRDFAnnotationParser (org.w3c.util.DateParser
            and InvalidDateException, for RDF annotation dates), loaded via
            annotationParsers.xml whenever an SBML file with RDF annotations is read; removing
            it breaks every SBML model read (confirmed by running the model tests). -->
        <dependency>
            <groupId>org.w3c.jigsaw</groupId>
            <artifactId>jigsaw</artifactId>
            <version>2.2.6</version>
        </dependency>
        <!-- Used by org.sbml.jsbml.validator.offline.factory.SBMLErrorFactory, which creates the
            errors JSBML throws for invalid values (e.g. an undefined unit), see
            JsbmlDependenciesTest. -->
        <dependency>
            <groupId>com.googlecode.json-simple</groupId>
            <artifactId>json-simple</artifactId>
            <version>1.1.1</version>
            <exclusions>
                <exclusion>
                    <groupId>junit</groupId>
                    <artifactId>junit</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Used by org.sbml.jsbml.xml.stax.SBMLWriter and
            org.sbml.jsbml.util.compilers.MathMLXMLStreamCompiler; confirmed with jdeps. -->
        <dependency>
            <groupId>com.fasterxml.staxmate</groupId>
            <artifactId>staxmate</artifactId>
            <version>2.4.2</version>
        </dependency>

        <dependency>
            <groupId>org.biojava</groupId>
            <artifactId>biojava-ontology</artifactId>
            <version>${biojava.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j-impl</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j2-impl</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Testing -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
