    </dependencies>

    <repositories>
        <!-- Cytoscape -->
        <repository>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
            <id>cytoscape_releases</id>
            <name>Cytoscape Releases</name>
            <url>https://nrnb-nexus.ucsd.edu/repository/cytoscape_releases/</url>
        </repository>
        <repository>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
            <id>cytoscape_thirdparty</id>
            <name>Cytoscape Thirdparty</name>
            <url>https://nrnb-nexus.ucsd.edu/repository/cytoscape_thirdparty/</url>
        </repository>
        <!-- JSBML  -->
        <repository>
            <id>in-project</id>
            <name>In project repository</name>
            <url>file:${project.basedir}/lib</url>
        </repository>
    </repositories>

    <build>
        <plugins>
            <!-- bundle -->
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <version>${maven-bundle-plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <!-- The BND instructions for the bundle -->
                    <instructions>
                        <Bundle-SymbolicName>${bundle.symbolicName}</Bundle-SymbolicName>
                        <Bundle-Version>${project.version}</Bundle-Version>
                        <Export-Package>${bundle.namespace}.*;version="${project.version}"</Export-Package>
                        <!-- The JSBML types are part of the API of the SBMLManager service, so
                            org.sbml.jsbml.* (inlined from the jsbml jars, see Embed-Dependency) is
                            exported, with the JSBML version instead of the app version. -->
                        <_exportcontents>org.sbml.jsbml.*;version="${jsbml.osgi.version}"</_exportcontents>
                        <Private-Package>${bundle.namespace}.*</Private-Package>
                        <Bundle-Activator>${bundle.namespace}.CyActivator</Bundle-Activator>
                        <!-- The jsbml/jsbml-* jars (built without their test classes by
                            scripts/update_jsbml.py) are inlined, i.e. their org/** classes and
                            resources are copied into the bundle, so that org.sbml.jsbml.* can be
                            exported; their META-INF (manifest and the ServiceLoader files, which
                            would overwrite each other) is left out, JSBML falls back to its
                            built-in parser list without them. All other dependencies, jtidy
                            included, are embedded as nested jars. -->
                        <Embed-Dependency>*;scope=!provided|test;groupId=!org.cytoscape;artifactId=!jsbml*,
                            jsbml*;groupId=cy3sbml-dep;scope=!provided|test;inline=org/**</Embed-Dependency>
                        <Embed-Transitive>true</Embed-Transitive>
                        <DynamicImport-Package>netscape.javascript</DynamicImport-Package>
                        <!-- do not turn the bnd @ServiceProvider annotations of embedded jars
                            (woodstox 7) into an osgi.serviceloader.registrar requirement, which
                            Cytoscape does not provide; see BundleJarContentIT -->
                        <_metainf-services>none</_metainf-services>
                        <!-- biojava-ontology 7.x ships a stray package-info.class in the
                            default package; bnd rejects a reference to the default package even
                            though that class is never loaded, so the error is downgraded -->
                        <_fixupmessages>"The default package '.' is not permitted";is:=warning</_fixupmessages>
                        <!--
                        <Import-Package>*;resolution:=optional</Import-Package>
                        -->
                        <Import-Package>javax.xml.namespace, *;resolution:=optional</Import-Package>
                    </instructions>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <inherited>true</inherited>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <showWarnings>true</showWarnings>
                    <showDeprecation>true</showDeprecation>
                    <compilerArgs>
                        <arg>-Xmaxwarns</arg>
                        <arg>10000</arg>
                        <arg>-Xmaxerrs</arg>
                        <arg>10000</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- resources -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.5.0</version>
            </plugin>
            <!-- jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>3.2.0</version>
            </plugin>
            <!-- pinned: the bundle packaging does not bind a version, so Maven
                resolves the newest one and warns about the Maven 4 betas -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>3.2.0</version>
            </plugin>
            <!-- javadoc: the javadoc jar is built by the javadoc profile (CI and
                releases), the configuration also applies to `javadoc:javadoc` -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <configuration>
                    <quiet>true</quiet>
                    <!-- all checks except missing comments, and warnings fail the build -->
                    <doclint>all,-missing</doclint>
                    <failOnWarnings>true</failOnWarnings>
                    <doctitle>cy3sbml ${project.version} API</doctitle>
                    <windowtitle>cy3sbml ${project.version} API</windowtitle>
                </configuration>
            </plugin>

            <!-- testing -->
            <!-- sets the property org.mockito:mockito-core:jar (path of the jar) for the
                surefire argLine -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.11.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <!-- @{argLine} is the JaCoCo agent. Mockito's inline mock maker is loaded
                        as an agent at startup instead of attaching itself at runtime, which
                        newer JDKs warn about and will disallow. With an agent on the boot class
                        path the JVM warns that class data sharing is limited, so it is off. -->
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
                    <groups>${test.groups}</groups>
                    <excludedGroups>${test.excludedGroups}</excludedGroups>
                    <!-- The large model corpora (BiGG, BioModels, SBML test suite, about
                        1.2 GB) are read from the classpath (/models/...) but are not test
                        resources, so they are not copied to target/test-classes on every
                        build; the directory is added to the test classpath as it is. -->
                    <additionalClasspathElements>
                        <additionalClasspathElement>${project.basedir}/src/test/corpora</additionalClasspathElement>
                    </additionalClasspathElements>
                </configuration>

            </plugin>

            <!-- packaged-bundle integration tests (*IT.java), run in the integration-test/
                verify phases against the already-packaged target/cy3sbml-<version>.jar, e.g.
                BundleJarContentIT checks the jar itself has the resources the app needs at
                runtime (see the task-3.12 investigation: a resource missing from the packaged
                jar aborted CyActivator.start and handed SBML imports to Cytoscape's own,
                broken bundled SBML app; a unit test running against target/classes cannot
                catch that, since target/classes still has everything). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <systemPropertyVariables>
                        <cy3sbml.bundle.jar>${project.build.directory}/${project.build.finalName}.jar</cy3sbml.bundle.jar>
                        <biojava.version>${biojava.version}</biojava.version>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- coverage -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <phase>test</phase>
                    </execution>
                </executions>
            </plugin>

            <!-- enforce build environment and dependency hygiene -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <dependencies>
                    <dependency>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>extra-enforcer-rules</artifactId>
                        <version>1.12.1</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[17,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <banDuplicatePomDependencyVersions/>
                                <banDuplicateClasses>
                                    <scopes>
                                        <scope>compile</scope>
                                        <scope>runtime</scope>
                                    </scopes>
                                    <findAllDuplicates>true</findAllDuplicates>
                                    <ignoreWhenIdentical>true</ignoreWhenIdentical>
                                </banDuplicateClasses>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                    <execution>
                        <id>enforce-release-dependencies</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <skip>${enforcer.skipReleaseDeps}</skip>
                            <rules>
                                <requireReleaseDeps/>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- formatting -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.10.3</version>
                <configuration>
                    <java>
                        <palantirJavaFormat>
                            <version>2.99.0</version>
                        </palantirJavaFormat>
                        <removeUnusedImports/>
                        <importOrder/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                    <pom>
                        <sortPom>
                            <nrOfIndentSpace>4</nrOfIndentSpace>
                            <expandEmptyElements>false</expandEmptyElements>
                        </sortPom>
                    </pom>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <profiles>
        <!-- Run all tests, including the network and models tagged tests. -->
        <profile>
            <id>all-tests</id>
            <properties>
                <test.excludedGroups/>
            </properties>
        </profile>
        <!-- Check the code with Error Prone and fail on compiler warnings.
            Error Prone needs JDK 21 or newer to run, the code still compiles with
            release 17. The JVM flags Error Prone needs are in .mvn/jvm.config. -->
        <profile>
            <id>lint</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <compilerArgs combine.children="append">
                                <arg>-XDcompilePolicy=simple</arg>
                                <!-- required by Error Prone on JDK 21 -->
                                <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                                <arg>--should-stop=ifError=FLOW</arg>
                                <arg>-Xplugin:ErrorProne</arg>
                                <arg>-Xlint:all,-processing,-serial</arg>
                                <arg>-Werror</arg>
                            </compilerArgs>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>com.google.errorprone</groupId>
                                    <artifactId>error_prone_core</artifactId>
                                    <version>${error-prone.version}</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Build the javadoc jar (target/cy3sbml-<version>-javadoc.jar) in the
            package phase. Used by CI and the release workflow; needs a full JDK
            (the javadoc tool). -->
        <profile>
            <id>javadoc</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadoc</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
