<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <properties>
        <bundle.symbolicName>cy3sbml</bundle.symbolicName>
        <bundle.namespace>org.cy3sbml</bundle.namespace>
        <cytoscape.api.version>3.10.0</cytoscape.api.version>
        <maven.compiler.release>17</maven.compiler.release>
        <maven-bundle-plugin.version>6.2.0</maven-bundle-plugin.version>
        <osgi.api.version>7.0.0</osgi.api.version>
        <osgi.compendium.version>7.0.0</osgi.compendium.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <org.osgi.framework.bootdelegation>netscape.javascript</org.osgi.framework.bootdelegation>
        <enforcer.skipReleaseDeps>false</enforcer.skipReleaseDeps>
        <!-- Pinned to the JSBML commit that built the jars in lib/cy3sbml-dep
            (see lib/build_jsbml_jars.sh for provenance): sbmlteam/jsbml commit
            22659a76927b24e23175563e2224bc56c05a0e74, committed 2023-01-03. -->
        <jsbml.version>1.7-20230103-22659a76</jsbml.version>
        <!-- JUnit tag-based test selection. By default the "network" (hits web
            services) and "models" (long-running model test suites) tagged tests
            are excluded. Run with -Pall-tests for everything, or select the
            network tests with -Dtest.groups=network -Dtest.excludedGroups= -->
        <test.excludedGroups>network,models</test.excludedGroups>
        <test.groups></test.groups>
    </properties>

    <groupId>org.cysbml</groupId>
    <artifactId>cy3sbml</artifactId>
    <packaging>bundle</packaging>
    <name>${bundle.symbolicName}</name>
    <version>0.5.1</version>
    <description>A Cytoscape app for SBML.</description>
    <url>https://github.com/matthiaskoenig/cy3sbml</url>

    <build>
        <plugins>
            <!-- bundle -->
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <version>${maven-bundle-plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <!-- The BND instructions for the bundle -->
                    <instructions>
                        <Bundle-SymbolicName>${bundle.symbolicName}</Bundle-SymbolicName>
                        <Bundle-Version>${project.version}</Bundle-Version>
                        <Export-Package>${bundle.namespace}.*;version="${project.version}",
					org.sbml.jsbml.*</Export-Package>
                        <Private-Package>${bundle.namespace}.*</Private-Package>
                        <Bundle-Activator>${bundle.namespace}.CyActivator</Bundle-Activator>
                        <Embed-Dependency>*;scope=!provided|test;groupId=!org.cytoscape</Embed-Dependency>
                        <Embed-Transitive>true</Embed-Transitive>
                        <DynamicImport-Package>netscape.javascript</DynamicImport-Package>
                        <!--
                        <Import-Package>*;resolution:=optional</Import-Package>
                        -->
                        <Import-Package>javax.xml.namespace, *;resolution:=optional</Import-Package>
                    </instructions>
                </configuration>
            </plugin>

            <plugin>
                <inherited>true</inherited>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <optimize>true</optimize>
                    <showWarnings>true</showWarnings>
                    <showDeprecation>true</showDeprecation>
                    <compilerArguments>
                        <Xmaxwarns>10000</Xmaxwarns>
                        <Xmaxerrs>10000</Xmaxerrs>
                    </compilerArguments>
                </configuration>
            </plugin>

            <!-- resources -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.5.0</version>
            </plugin>
            <!-- jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>3.2.0</version>
            </plugin>

            <!-- testing -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <groups>${test.groups}</groups>
                    <excludedGroups>${test.excludedGroups}</excludedGroups>
                </configuration>

            </plugin>

            <!-- coverage -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- enforce build environment and dependency hygiene -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <dependencies>
                    <dependency>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>extra-enforcer-rules</artifactId>
                        <version>1.12.1</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[17,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <banDuplicatePomDependencyVersions/>
                                <banDuplicateClasses>
                                    <scopes>
                                        <scope>compile</scope>
                                        <scope>runtime</scope>
                                    </scopes>
                                    <findAllDuplicates>true</findAllDuplicates>
                                    <ignoreWhenIdentical>true</ignoreWhenIdentical>
                                    <ignoreClasses>
                                        <!-- xstream (needed by JSBML's validator, see the
                                            dependency comment below) pulls in both xmlpull and
                                            xpp3_min, which both provide the same XmlPull API
                                            classes. -->
                                        <ignoreClass>org.xmlpull.v1.*</ignoreClass>
                                    </ignoreClasses>
                                </banDuplicateClasses>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                    <execution>
                        <id>enforce-release-dependencies</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <skip>${enforcer.skipReleaseDeps}</skip>
                            <rules>
                                <requireReleaseDeps/>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>6.1.3</version>
