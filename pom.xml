<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.cysbml</groupId>
    <artifactId>cy3sbml</artifactId>
    <version>0.8.1</version>
    <packaging>bundle</packaging>
    <name>${bundle.symbolicName}</name>
    <description>A Cytoscape app for SBML.</description>
    <url>https://github.com/matthiaskoenig/cy3sbml</url>

    <properties>
        <bundle.symbolicName>cy3sbml</bundle.symbolicName>
        <bundle.namespace>org.cy3sbml</bundle.namespace>
        <cytoscape.api.version>3.10.0</cytoscape.api.version>
        <maven.compiler.release>17</maven.compiler.release>
        <error-prone.version>2.50.0</error-prone.version>
        <maven-bundle-plugin.version>6.2.0</maven-bundle-plugin.version>
        <osgi.api.version>7.0.0</osgi.api.version>
        <slf4j.version>2.0.20</slf4j.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <org.osgi.framework.bootdelegation>netscape.javascript</org.osgi.framework.bootdelegation>
        <enforcer.skipReleaseDeps>false</enforcer.skipReleaseDeps>
        <!-- JSBML jars in lib/cy3sbml-dep, built from one sbmlteam/jsbml commit:
            <JSBML version>-<commit date>-<short sha>. Both properties are set by
            scripts/update_jsbml.py, see docs/development/dependencies.md. -->
        <jsbml.version>1.7-20260929-7b28ca71</jsbml.version>
        <!-- The same JSBML version as an OSGi version, used for the exported
            org.sbml.jsbml packages. -->
        <jsbml.osgi.version>1.7.0.20260929-7b28ca71</jsbml.osgi.version>
        <!-- biojava-ontology, embedded as a nested jar for JSBML (org.sbml.jsbml.SBO);
            also passed to BundleJarContentIT, which checks the nested jar by name -->
        <biojava.version>7.3.0</biojava.version>
        <!-- JUnit tag-based test selection. By default the "network" (hits web
            services) and "models" (long-running model test suites) tagged tests
            are excluded. Run with -Pall-tests for everything, or select the
            network tests with -Dtest.groups=network -Dtest.excludedGroups= -->
        <test.excludedGroups>network,models</test.excludedGroups>
        <test.groups/>
        <!-- set by the JaCoCo agent; empty when JaCoCo is skipped (-Djacoco.skip) -->
        <argLine/>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>6.1.3</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

