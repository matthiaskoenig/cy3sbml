<?xml version="1.0" encoding="UTF-8"?>
<sbml xmlns="http://www.sbml.org/sbml/level3/version2/core" xmlns:comp="http://www.sbml.org/sbml/level3/version1/comp/version1" xmlns:distrib="http://www.sbml.org/sbml/level3/version1/distrib/version1" level="3" version="2" comp:required="true" distrib:required="true">
  <model id="distrib_comp">
    <comp:listOfSubmodels>
      <comp:submodel comp:id="A" comp:modelRef="sub"/>
    </comp:listOfSubmodels>
  </model>
  <comp:listOfModelDefinitions>
    <comp:modelDefinition id="sub">
      <listOfUnitDefinitions>
        <unitDefinition id="per_s">
          <listOfUnits>
            <unit kind="second" exponent="-1" scale="0" multiplier="1"/>
          </listOfUnits>
        </unitDefinition>
      </listOfUnitDefinitions>
      <listOfParameters>
        <parameter id="sd" value="0.2" units="per_s" constant="true"/>
        <parameter id="k1" value="1" units="per_s" constant="true">
          <distrib:listOfUncertainties>
            <distrib:uncertainty>
              <distrib:uncertParameter distrib:var="sd" distrib:units="per_s" distrib:type="standardDeviation"/>
              <distrib:uncertSpan distrib:type="range" distrib:varLower="sd" distrib:varUpper="k1"/>
            </distrib:uncertainty>
          </distrib:listOfUncertainties>
        </parameter>
      </listOfParameters>
    </comp:modelDefinition>
  </comp:listOfModelDefinitions>
</sbml>
