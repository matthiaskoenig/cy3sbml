<!-- Logging of the tests: console only, warnings and errors.
     Takes precedence over src/main/resources/logback.xml, the file log of the app,
     which needs the cy3sbml.logfile property set by CyActivator. -->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <!-- the errors the tests cause on purpose -->
        <filter class="org.cy3sbml.ExpectedMessageFilter">
            <!-- CyActivatorTest: a missing bundle resource -->
            <message>cy3sbml panel disabled: extension jar missing from the bundle</message>
            <!-- ResourceExtractorTest: no app directory -->
            <message>appDirectory is not set in ResourceExtractor</message>
            <!-- SBMLReaderTaskTest: a broken file, a reader that fails on the second model -->
            <message>cy3sbml could not read the SBML file '(broken|01134-sbml-l3v1)\.xml': .*</message>
            <!-- CompModelsTest: a wrong md5 checksum, a missing external file -->
            <message>The md5 checksum of .*/models/comp/unit/ext\.xml is .* The file may have changed\.</message>
            <message>The file .*/models/comp/unit/missing\.xml does not exist\.</message>
            <!-- unittests/small_population.xml: the copy of a Watanabe2014 model without its
                 external file represCirc.xml -->
            <message>The file .*/models/unittests/represCirc\.xml does not exist\.</message>
        </filter>
        <encoder>
            <pattern>%-5level \(%logger{36}\) - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- JSBML (log4j 1.x API, routed to slf4j by log4j-over-slf4j). The JSBML XML parsers
         warn on the test models (notes without the XHTML namespace, unknown attributes,
         broken files); other JSBML warnings stay visible. -->
    <logger name="org.sbml.jsbml.AbstractMathContainer" level="ERROR" />
    <logger name="org.sbml.jsbml.xml" level="ERROR" />
    <!-- SessionDataTest injects failures, which SessionData logs with their stack trace -->
    <logger name="org.cy3sbml.SessionData" level="OFF" />
    <!-- LatestTaskExecutorTest deliberately submits a task that throws, which
         LatestTaskExecutor logs with its stack trace -->
    <logger name="org.cy3sbml.gui.LatestTaskExecutor" level="OFF" />

    <!-- Loggers that warn on the deliberate inputs of the tests are raised to ERROR, so a
         warning in the test output stands out. Every other logger stays at WARN. -->
    <!-- the test models: comp links to other submodels, external model definitions,
         layouts, elements without metaId -->
    <logger name="org.cy3sbml.reader.CompReader" level="ERROR" />
    <logger name="org.cy3sbml.reader.LayoutReader" level="ERROR" />
    <logger name="org.cy3sbml.reader.SBMLReaderTask" level="ERROR" />
    <logger name="org.cy3sbml.util.MappingUtil" level="ERROR" />
    <!-- malformed inputs: flux bounds, layout files, XML strings, proxy settings -->
    <logger name="org.cy3sbml.reader.FbcReader" level="ERROR" />
    <logger name="org.cy3sbml.layout.XMLInterface" level="ERROR" />
    <logger name="org.cy3sbml.util.XMLUtil" level="ERROR" />
    <logger name="org.cy3sbml.util.GUIUtil" level="ERROR" />
    <logger name="org.cy3sbml.ConnectionProxy" level="ERROR" />
    <!-- web-service fixtures: error statuses, timeouts, incomplete entries -->
    <logger name="org.cy3sbml.util.HttpJson" level="ERROR" />
    <logger name="org.cy3sbml.miriam.MiriamRegistry" level="ERROR" />
    <logger name="org.cy3sbml.ols.OlsClient" level="ERROR" />
    <logger name="org.cy3sbml.uniprot.UniprotAccess" level="ERROR" />
    <logger name="org.cy3sbml.chebi.ChebiAccess" level="ERROR" />
    <logger name="org.cy3sbml.biomodel.SearchBioModel" level="ERROR" />
    <logger name="org.cy3sbml.biomodel.BiomodelLoader" level="ERROR" />

    <root level="WARN">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
